#!/bin/bash
#PBS -N life_engine
#PBS -l walltime=24:00:00
#PBS -l nodes=1:ppn=1
#PBS -l mem=4gb
#PBS -q serial
#PBS -o logs/life_engine_${PBS_JOBID}.out
#PBS -e logs/life_engine_${PBS_JOBID}.err
#PBS -m abe
#PBS -M tariquemackay@gmail.com

# ─── Configuration ────────────────────────────────────────────────────────────
# Edit these variables before submitting.

MAX_TICKS=1000000          # number of simulation ticks to run
OUTPUT="results_${PBS_JOBID}.json"  # output file name
CONFIG=""                  # path to a hyperparameter JSON file (leave empty to use defaults)
LOAD=""                    # path to a saved environment JSON to start from (leave empty for fresh run)
LOG_EVERY=10000            # print progress every N ticks

# Path to the Node 16 binary installed via nvm
NODE_BIN="/home/tmackay/.nvm/versions/node/v16.20.2/bin/node"

# Project root (absolute path)
PROJECT_DIR="/home/tmackay/LifeEngine"

# ─── Environment setup ────────────────────────────────────────────────────────

echo "=== Job info ==="
echo "Job ID:   $PBS_JOBID"
echo "Job name: $PBS_JOBNAME"
echo "Node:     $(hostname)"
echo "Date:     $(date)"
echo "Working dir: $PBS_O_WORKDIR"
echo ""

cd "$PROJECT_DIR" || { echo "ERROR: Cannot cd to $PROJECT_DIR"; exit 1; }

# Create logs directory if it doesn't exist
mkdir -p logs

# Verify node is available
if [ ! -x "$NODE_BIN" ]; then
    echo "ERROR: Node binary not found at $NODE_BIN"
    exit 1
fi
echo "Node version: $($NODE_BIN --version)"
echo ""

# ─── Build CLI arguments ──────────────────────────────────────────────────────

ARGS="--max-ticks $MAX_TICKS --output $OUTPUT --log-every $LOG_EVERY"
[ -n "$CONFIG" ] && ARGS="$ARGS --config $CONFIG"
[ -n "$LOAD"   ] && ARGS="$ARGS --load $LOAD"

# ─── Run simulation ───────────────────────────────────────────────────────────

echo "=== Starting simulation ==="
echo "Command: $NODE_BIN src/headless.js $ARGS"
echo ""

"$NODE_BIN" src/headless.js $ARGS
EXIT_CODE=$?

echo ""
echo "=== Simulation finished ==="
echo "Exit code: $EXIT_CODE"
echo "Date:      $(date)"

if [ $EXIT_CODE -ne 0 ]; then
    echo "ERROR: Simulation exited with code $EXIT_CODE"
    exit $EXIT_CODE
fi

echo "Results saved to: $PROJECT_DIR/$OUTPUT"
