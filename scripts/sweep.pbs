#!/bin/bash
# ─────────────────────────────────────────────────────────────────────────────
# CHPC PBS script — runs one environment with N seeds in PARALLEL.
#
# Usage (one job per environment):
#   qsub -v CONFIG=Experiment1_Base.json,SEEDS="1 2 3 4 5",MAX_TICKS=10000000 scripts/sweep.pbs
#   qsub -v CONFIG=experiment_2_allopatric.json,SEEDS="1 2 3 4 5",MAX_TICKS=10000000 scripts/sweep.pbs
#   qsub -v CONFIG=experiment_3_archipelago.json,SEEDS="1 2 3 4 5",MAX_TICKS=10000000 scripts/sweep.pbs
#   qsub -v CONFIG=Islands.json,SEEDS="1 2 3 4 5",MAX_TICKS=10000000 scripts/sweep.pbs
#
# To run sequentially instead of in parallel (e.g. if you can only get 1 core):
#   qsub -v CONFIG=Experiment1_Base.json,SEEDS="1 2 3 4 5",MODE=sequential scripts/sweep.pbs
# and change the #PBS -l select line to ncpus=1.
#
# Outputs are split into two parallel folders:
#   results/<env_name>/seed_<N>.json          — tracked simulation stats (analysis)
#   worlds/<env_name>/seed_<N>_world.json     — browser-loadable end-of-run snapshot
# Predation maps (controls.deadTurnToFood=true) naturally land in their own
# env folder because the env_name is derived from the map filename — e.g.
# results/map_500_d05_predation/seed_1.json. Existing outputs are
# skipped so re-submitting after a crash resumes the remaining seeds.
# ─────────────────────────────────────────────────────────────────────────────

#PBS -N life_sweep
#PBS -P CSCI1142
# 48h, not 12h: surviving 10M-tick runs on this fleet took a median 9.5h and a
# max of 26.7h in the previous sweep, and restricting the maps to mean distance
# < 100 raises survival, so MORE runs now go the full distance. At 12h the
# longest runs were being killed. Matches sweep.slurm.
#PBS -l walltime=48:00:00
#PBS -l select=1:ncpus=5:mem=24gb
#PBS -q normal
#PBS -o logs/sweep_${PBS_JOBID}.out
#PBS -e logs/sweep_${PBS_JOBID}.err
#PBS -m abe
#PBS -M tariquemackay@gmail.com

# ─── Defaults (overridable via -v at qsub time) ──────────────────────────────
: "${CONFIG:?must pass -v CONFIG=<env.json>}"
: "${SEEDS:=1 2 3 4 5}"
: "${MAX_TICKS:=10000000}"
: "${DATA_RATE:=1000}"
: "${KEEP_MIN:=50}"
: "${LOG_EVERY:=100000}"
: "${WORLD_SEEDS:=all}"        # all | none | "1 2" — which seeds write a world snapshot
: "${MODE:=parallel}"             # parallel | sequential
: "${SUMMARY_EMAIL:=tariquemackay@gmail.com}"   # detailed end-of-job summary recipient

# ─── Paths (overridable via -v at qsub time) ─────────────────────────────────
# Run from lustre scratch, not /home — a full /home quota crashes jobs mid-sweep
# (the ~/lustre symlink points at lustre scratch on Lengau).
NODE_BIN="${NODE_BIN:-/home/tmackay/.nvm/versions/node/v16.20.2/bin/node}"
PROJECT_DIR="${PROJECT_DIR:-$HOME/lustre/LifeEngine}"

# ─── Job info ────────────────────────────────────────────────────────────────
echo "=== Job info ==="
echo "Job ID:        $PBS_JOBID"
echo "Node:          $(hostname)"
echo "Date:          $(date)"
echo "Config:        $CONFIG"
echo "Seeds:         $SEEDS"
echo "Max ticks:     $MAX_TICKS"
echo "Data rate:     $DATA_RATE"
echo "Keep-min:      $KEEP_MIN"
echo "World seeds:   $WORLD_SEEDS"
echo "Mode:          $MODE"
echo ""

cd "$PROJECT_DIR" || { echo "ERROR: Cannot cd to $PROJECT_DIR"; exit 1; }
mkdir -p logs

if [ ! -x "$NODE_BIN" ]; then
    echo "ERROR: Node binary not found at $NODE_BIN"; exit 1
fi
if [ ! -f "$CONFIG" ]; then
    echo "ERROR: Config file '$CONFIG' not found in $PROJECT_DIR"; exit 1
fi

# Derive a clean env name from the config file (strip path + .json).
# Predation variants (filename ends in _predation) automatically get a
# separate env folder, so results are easy to identify at a glance.
ENV_NAME="$(basename "$CONFIG" .json)"
RESULTS_DIR="results/${ENV_NAME}"
WORLDS_DIR="worlds/${ENV_NAME}"
mkdir -p "$RESULTS_DIR" "$WORLDS_DIR"
echo "Results dir:   $RESULTS_DIR"
echo "Worlds dir:    $WORLDS_DIR"
echo ""

# ─── Per-seed runner ─────────────────────────────────────────────────────────
run_seed() {
    local SEED=$1
    local OUT="${RESULTS_DIR}/seed_${SEED}.json"
    local WORLD="${WORLDS_DIR}/seed_${SEED}_world.json"
    local SEED_LOG="logs/${ENV_NAME}_seed_${SEED}_${PBS_JOBID}.log"

    if [ -f "$OUT" ]; then
        echo "[seed $SEED] SKIP — $OUT already exists"
        return 0
    fi

    echo "[seed $SEED] start → $OUT (log: $SEED_LOG)"
    # World snapshots are ~23 MB each and are only needed to reopen a run in the
    # browser — the analysis never reads them. On a 20-seed sweep they dominate
    # the disk bill, so WORLD_SEEDS limits which seeds write one.
    #   WORLD_SEEDS=all   every seed (default, previous behaviour)
    #   WORLD_SEEDS=none  no snapshots
    #   WORLD_SEEDS="1 2" only these seeds
    local SAVE_WORLD_ARGS=()
    case " $WORLD_SEEDS " in
        *" all "*)  SAVE_WORLD_ARGS=(--save-world "$WORLD") ;;
        *" none "*) SAVE_WORLD_ARGS=() ;;
        *" $SEED "*) SAVE_WORLD_ARGS=(--save-world "$WORLD") ;;
        *) SAVE_WORLD_ARGS=() ;;
    esac

    "$NODE_BIN" src/headless.js \
        --max-ticks "$MAX_TICKS" \
        --load      "$CONFIG" \
        --seed      "$SEED" \
        --data-rate "$DATA_RATE" \
        --keep-min  "$KEEP_MIN" \
        --output    "$OUT" \
        "${SAVE_WORLD_ARGS[@]}" \
        --log-every "$LOG_EVERY" \
        > "$SEED_LOG" 2>&1
    local EC=$?
    if [ $EC -eq 0 ]; then
        echo "[seed $SEED] DONE — $OUT"
    else
        echo "[seed $SEED] FAILED with exit code $EC — see $SEED_LOG"
    fi
    return $EC
}

# ─── Dispatch ────────────────────────────────────────────────────────────────
echo "=== Starting sweep ($MODE) ==="
echo ""
START=$SECONDS
PIDS=()
FAILED=0

if [ "$MODE" = "parallel" ]; then
    for S in $SEEDS; do
        run_seed "$S" &
        PIDS+=($!)
    done
    # wait for each, count failures (don't short-circuit on first failure)
    for PID in "${PIDS[@]}"; do
        if ! wait "$PID"; then FAILED=$((FAILED + 1)); fi
    done
else
    for S in $SEEDS; do
        if ! run_seed "$S"; then FAILED=$((FAILED + 1)); fi
    done
fi

ELAPSED=$((SECONDS - START))
echo ""
echo "=== Sweep finished ==="
echo "Elapsed: ${ELAPSED}s  ($(printf '%dh:%02dm' $((ELAPSED/3600)) $(((ELAPSED%3600)/60))))"
echo "Failed seeds: $FAILED"
echo "Date: $(date)"

# ─── Detailed per-seed summary: always saved, best-effort emailed ────────────
# The scheduler's own -m abe mail stays the reliable notification; this adds a
# rich per-seed report. Compute nodes on some clusters can't send mail, so the
# summary is ALWAYS written to the results dir.
SUMMARY_FILE="${RESULTS_DIR}/SUMMARY_${PBS_JOBID}.txt"
SUMMARY_BODY="$(python3 scripts/_job_summary.py "$RESULTS_DIR" \
    env="$ENV_NAME" job="$PBS_JOBID" config="$CONFIG" \
    seeds="$SEEDS" max_ticks="$MAX_TICKS" elapsed_s="$ELAPSED" failed="$FAILED")"
printf '%s\n' "$SUMMARY_BODY" | tee "$SUMMARY_FILE"
SUBJECT="[LifeEngine] ${ENV_NAME} — $([ "$FAILED" -eq 0 ] && echo OK || echo "${FAILED} FAILED") (job ${PBS_JOBID})"
if   command -v mail     &>/dev/null; then printf '%s\n' "$SUMMARY_BODY" | mail  -s "$SUBJECT" "$SUMMARY_EMAIL" && echo "[summary] emailed to $SUMMARY_EMAIL" || echo "[summary] mail failed; saved $SUMMARY_FILE"
elif command -v mailx    &>/dev/null; then printf '%s\n' "$SUMMARY_BODY" | mailx -s "$SUBJECT" "$SUMMARY_EMAIL" && echo "[summary] emailed to $SUMMARY_EMAIL" || echo "[summary] mailx failed; saved $SUMMARY_FILE"
elif command -v sendmail &>/dev/null; then { printf 'To: %s\nSubject: %s\n\n' "$SUMMARY_EMAIL" "$SUBJECT"; printf '%s\n' "$SUMMARY_BODY"; } | sendmail -t && echo "[summary] emailed to $SUMMARY_EMAIL" || echo "[summary] sendmail failed; saved $SUMMARY_FILE"
else echo "[summary] no mail tool (mail/mailx/sendmail) on this node — saved $SUMMARY_FILE"; fi

# Exit non-zero if anything failed, so PBS marks the job accordingly
exit $FAILED
